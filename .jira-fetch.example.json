{
  "$schema": "./schema/jira-fetch.schema.json",

  "baseUrl": "https://your-site.atlassian.net",

  "allowJql": true,

  "filters": {
    "exclude": [
      { "project": ["SUP"] },
      { "labels": ["wontfix", "duplicate"] },
      { "field": { "Team": ["Platform"], "Components": ["api"] } },
      { "title": { "matches": "^(spike|chore):", "flags": "i" } },
      { "reporter": [null] },
      { "assignee": [null] }
    ],

    "comments": {
      "exclude": [
        { "author": ["Automation for Jira"] }
      ]
    }
  }
}
