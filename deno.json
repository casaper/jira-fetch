{
  "name": "jira-fetch",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "check": "deno check src/ scripts/ && deno fmt --check && deno run -A scripts/gen_schema.ts --check",
    "test": "deno test -A",
    "schema": "deno run -A scripts/gen_schema.ts",
    "build": "deno run -A scripts/build_all.ts --host",
    "build:all": "deno run -A scripts/build_all.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "zod": "npm:zod@^4.4.3"
  }
}
