{
  "name": "jira-fetch",
  "version": "0.5.4",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env=HOME,APPDATA,USERPROFILE --allow-read --allow-write src/main.ts",
    "mcp": "deno run --allow-net --allow-env=HOME,APPDATA,USERPROFILE --allow-read --allow-write src/main.ts mcp",
    "check": "deno check src/ scripts/ && deno lint && deno fmt --check && deno run -A scripts/gen_schema.ts --check && deno run -A scripts/gen_types.ts --check",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A",
    "verify:filters": "deno run --allow-net --allow-env=HOME,APPDATA,USERPROFILE --allow-read --allow-write scripts/verify_filters.ts",
    "schema": "deno run -A scripts/gen_schema.ts",
    "vendor:spec": "deno run --allow-net --allow-read --allow-write scripts/vendor_spec.ts",
    "types": "deno run -A scripts/gen_types.ts",
    "hooks": "git config core.hooksPath .githooks && echo 'commit-msg hook enabled'",
    "commitlint": "deno run -A scripts/commit_lint.ts",
    "changelog": "deno run -A scripts/changelog.ts",
    "release": "deno run -A scripts/release.ts",
    "publish": "deno run -A scripts/publish.ts",
    "build": "deno run -A scripts/build_all.ts --host",
    "build:all": "deno run -A scripts/build_all.ts",
    "npm:pack": "deno run -A scripts/npm_package.ts"
  },
  "fmt": {
    "exclude": [
      "spec/"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-boolean-literal-for-arguments",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-inferrable-types",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-undef",
        "no-useless-rename",
        "single-var-declarator",
        "triple-slash-reference",
        "verbatim-module-syntax"
      ]
    }
  },
  "imports": {
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@^2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "zod": "npm:zod@^4.4.3"
  }
}
